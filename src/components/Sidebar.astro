---
const sections = [
  {
    name: "Experience",
    href: "#experience",
  },
  {
    name: "Skills",
    href: "#skills",
  },
  {
    name: "Projects",
    href: "#projects",
  },
  {
    name: "About",
    href: "#about",
  },
];
---

<nav class="p-6">
  <ul class="flex flex-col space-y-4">
    {
      sections.map((section) => (
        <li>
          <a
            href={section.href}
            class="text-white hover:text-gray-200 transition-colors"
          >
            {section.name}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
